# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For server-side operations (if using Supabase Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notifications / Email Dispatch (Supabase Edge Functions)
NOTIFICATIONS_DISPATCHER_SECRET=your-dispatcher-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="PixelTrack Notifications <notify@example.com>"

# Application Configuration
VITE_APP_NAME=PixelTrack
